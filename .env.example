# Optional. The hint coach works fully offline without any of this — these only
# affect how hints are *phrased* on the web/dev build. See docs/DECISIONS.md D-007.

# Where Ollama is listening.
VITE_OLLAMA_HOST=http://localhost:11434

# Which local model rewords hints. Small and fast beats clever here: the hint
# has a hard 1.5s budget and is dropped if it misses it.
VITE_OLLAMA_MODEL=gemma3:4b

# Set to true to force the offline explainer, which is what ships to devices.
VITE_DISABLE_OLLAMA=false
