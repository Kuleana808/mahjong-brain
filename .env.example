# Every one of these is optional, and every one fails closed. Whatever is not
# set stays unconfigured, and the endpoints that need it answer
# `source_available` naming the missing key. Nothing here has a permissive
# default. See docs/api-contracts.md.

# --- hint coach (contract 5) -------------------------------------------------
# The coach works fully offline without any of this. These only affect how hints
# are *phrased* on the web/dev build. See docs/DECISIONS.md D-007.

VITE_OLLAMA_HOST=http://localhost:11434

# Small and fast beats clever: the hint has a hard 1.5s budget and is dropped if
# it misses it.
VITE_OLLAMA_MODEL=gemma3:4b

# Force the offline explainer, which is what ships to devices.
VITE_DISABLE_OLLAMA=false


# --- local backend, no Supabase needed ---------------------------------------
# Turns contracts 3, 4, 9 and 10 on against an in-process store. Ignored
# whenever real Supabase credentials are set.
#
#   NIHI_DEV_STORE=memory
#   NIHI_DEV_STORE_FILE=./.nihi-dev-store.json   # survive restarts

NIHI_DEV_STORE=
NIHI_DEV_STORE_FILE=


# --- Supabase (contracts 4, 9, 10) -------------------------------------------
# Both or neither. Half a pair is treated as unconfigured and says so at boot,
# because guessing is worse than refusing.
#
# SERVICE ROLE KEY IS SERVER-SIDE ONLY. It bypasses row-level security. It must
# never reach a client, a build artefact, or this file with a real value in it.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# --- sessions (contracts 4, 9) -----------------------------------------------
# 32+ characters. Rotating it signs everyone out, which is fine.
#   openssl rand -hex 32

SESSION_SIGNING_KEY=


# --- Sign in with Apple (contract 3) -----------------------------------------
# This is the `aud` claim every identity token is checked against. Without it a
# token minted for any other app would be accepted — which is an account
# takeover, and the account carries the purchase unlock. Blocked on D-001.

APPLE_BUNDLE_ID=


# --- StoreKit 2 (contract 8) -------------------------------------------------
# Base64 of AppleRootCA-G3.cer from https://www.apple.com/certificateauthority/
#
# PIN IT. Do not fetch it at runtime — a root you download at boot is a root an
# attacker who controls the network can replace. A malformed value fails at
# construction so a bad deployment breaks at boot, not on the first purchase.

APPLE_ROOT_CA_G3_BASE64=
IAP_PRODUCT_ID=com.nihi.mahjong.lifetime


# --- api ---------------------------------------------------------------------
PORT=5185
