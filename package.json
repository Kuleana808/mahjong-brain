{
  "name": "mahjong-brain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "check:design-drift": "node scripts/check-design-drift.mjs",
    "check:brand-assets": "node scripts/check-brand-assets.mjs",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "api:dev": "npm --workspace @mahjong-brain/api run dev",
    "api": "npm --workspace @mahjong-brain/api run start",
    "smoke:events": "npm --workspace @mahjong-brain/api run smoke:events",
    "marketing:dev": "npm --workspace @mahjong-brain/marketing run dev",
    "marketing:build": "npm --workspace @mahjong-brain/marketing run build",
    "preflight": "npm run check:design-drift && npm run check:brand-assets && node scripts/preflight.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
